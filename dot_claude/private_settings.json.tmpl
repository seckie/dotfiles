{
  "effortLevel"{{ .chezmoi.pathListSeparator }} "high",
  "enabledPlugins"{{ .chezmoi.pathListSeparator }} {
    "commit-commands@claude-plugins-official"{{ .chezmoi.pathListSeparator }} true,
    "emoffice-team@revcomm"{{ .chezmoi.pathListSeparator }} true,
    "security-guidance@claude-plugins-official"{{ .chezmoi.pathListSeparator }} true,
    "skill-creator@claude-plugins-official"{{ .chezmoi.pathListSeparator }} true,
    "softphone-team@revcomm"{{ .chezmoi.pathListSeparator }} true
  },
  "extraKnownMarketplaces"{{ .chezmoi.pathListSeparator }} {
    "anthropic-agent-skills"{{ .chezmoi.pathListSeparator }} {
      "source"{{ .chezmoi.pathListSeparator }} {
        "repo"{{ .chezmoi.pathListSeparator }} "anthropics{{ .chezmoi.pathSeparator }}skills",
        "source"{{ .chezmoi.pathListSeparator }} "github"
      }
    }
  },
  "hooks"{{ .chezmoi.pathListSeparator }} {
    "PreToolUse"{{ .chezmoi.pathListSeparator }} [
      {
        "hooks"{{ .chezmoi.pathListSeparator }} [
          {
            "command"{{ .chezmoi.pathListSeparator }} "rtk hook claude",
            "type"{{ .chezmoi.pathListSeparator }} "command"
          }
        ],
        "matcher"{{ .chezmoi.pathListSeparator }} "Bash"
      }
    ],
    "UserPromptSubmit"{{ .chezmoi.pathListSeparator }} [
      {
        "hooks"{{ .chezmoi.pathListSeparator }} [
          {
            "command"{{ .chezmoi.pathListSeparator }} "echo '{\"hookSpecificOutput\"{{ .chezmoi.pathListSeparator }}{\"hookEventName\"{{ .chezmoi.pathListSeparator }}\"UserPromptSubmit\",\"additionalContext\"{{ .chezmoi.pathListSeparator }}\"ツール実行より先に、この発話への返答 (回答、または受け止めと進め方) を本文で書くこと\"{{ "}}" }}'",
            "type"{{ .chezmoi.pathListSeparator }} "command"
          }
        ]
      }
    ]
  },
  "model"{{ .chezmoi.pathListSeparator }} "sonnet",
  "permissions"{{ .chezmoi.pathListSeparator }} {
    "allow"{{ .chezmoi.pathListSeparator }} [
      "Bash(gh pr view{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh pr list{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh pr create{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh pr checkout{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh pr comment{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh pr edit{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh issue view{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh issue list{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh repo view{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh search{{ .chezmoi.pathListSeparator }}*)",
      "Bash(gh auth status)",
      "Bash(gh --version)"
    ]
  },
  "sandbox"{{ .chezmoi.pathListSeparator }} {
    "allowUnsandboxedCommands"{{ .chezmoi.pathListSeparator }} false,
    "enabled"{{ .chezmoi.pathListSeparator }} true,
    "excludedCommands"{{ .chezmoi.pathListSeparator }} [
      "gh *"
    ],
    "network"{{ .chezmoi.pathListSeparator }} {
      "allowedDomains"{{ .chezmoi.pathListSeparator }} [
        "github.com",
        "api.github.com"
      ]
    }
  },
  "statusLine"{{ .chezmoi.pathListSeparator }} {
    "command"{{ .chezmoi.pathListSeparator }} "bash ~{{ .chezmoi.pathSeparator }}.claude{{ .chezmoi.pathSeparator }}statusline-command.sh",
    "refreshInterval"{{ .chezmoi.pathListSeparator }} 30,
    "type"{{ .chezmoi.pathListSeparator }} "command"
  }
}
