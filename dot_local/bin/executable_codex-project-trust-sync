#!/usr/bin/env python3
"""Move Codex project trust entries out of config.toml after a CLI run."""

from __future__ import annotations

import os
import re
import sys
import tempfile
from pathlib import Path


PROJECT_HEADER = re.compile(
    r'''^\[projects\.(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')\][ \t]*(?:#.*)?$'''
)
TABLE_HEADER = re.compile(r"^\[\[?[^\n]+\]\]?\s*(?:#.*)?$")


def is_project_header(line: str) -> bool:
    return bool(PROJECT_HEADER.fullmatch(line.rstrip("\r\n")))


def is_table_header(line: str) -> bool:
    return bool(TABLE_HEADER.fullmatch(line.rstrip("\r\n")))


def split_project_tables(text: str) -> tuple[str, list[str]]:
    lines = text.splitlines(keepends=True)
    remaining: list[str] = []
    projects: list[str] = []
    index = 0

    while index < len(lines):
        if not is_project_header(lines[index]):
            remaining.append(lines[index])
            index += 1
            continue

        block = [lines[index]]
        index += 1
        while index < len(lines) and not is_table_header(lines[index]):
            block.append(lines[index])
            index += 1

        while block and not block[-1].strip():
            block.pop()
        projects.append("".join(block).rstrip() + "\n")

    return "".join(remaining), projects


def block_key(block: str) -> str:
    return block.splitlines()[0].strip()


def atomic_write(path: Path, text: str) -> None:
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(text)
        os.replace(temporary, path)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
    config_path = codex_home / "config.toml"
    trust_path = codex_home / "project-trust.config.toml"

    if not config_path.is_file():
        return 0

    config_text = config_path.read_text(encoding="utf-8")
    config_without_projects, discovered = split_project_tables(config_text)
    if not discovered:
        return 0

    existing_text = trust_path.read_text(encoding="utf-8") if trust_path.is_file() else ""
    preamble, existing = split_project_tables(existing_text)
    merged: dict[str, str] = {block_key(block): block for block in existing}
    merged.update({block_key(block): block for block in discovered})

    trust_sections = "\n".join(merged.values()).rstrip() + "\n"
    trust_text = preamble.rstrip() + ("\n\n" if preamble.strip() else "") + trust_sections

    codex_home.mkdir(parents=True, exist_ok=True)
    atomic_write(trust_path, trust_text)
    atomic_write(config_path, config_without_projects.rstrip() + "\n")
    entry_word = "entry" if len(discovered) == 1 else "entries"
    print(f"codex-project-trust-sync: moved {len(discovered)} project {entry_word}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, ValueError) as error:
        print(f"codex-project-trust-sync: {error}", file=sys.stderr)
        raise SystemExit(1)
