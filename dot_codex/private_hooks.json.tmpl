{
  "hooks"{{ .chezmoi.pathListSeparator }} {
    "SessionEnd"{{ .chezmoi.pathListSeparator }} [
      {
        "hooks"{{ .chezmoi.pathListSeparator }} [
          {
            "command"{{ .chezmoi.pathListSeparator }} "{{ .chezmoi.destDir }}{{ .chezmoi.pathSeparator }}.local{{ .chezmoi.pathSeparator }}bin{{ .chezmoi.pathSeparator }}codex-project-trust-sync",
            "timeout"{{ .chezmoi.pathListSeparator }} 3,
            "type"{{ .chezmoi.pathListSeparator }} "command"
          }
        ],
        "matcher"{{ .chezmoi.pathListSeparator }} "other"
      }
    ],
    "SessionStart"{{ .chezmoi.pathListSeparator }} [
      {
        "hooks"{{ .chezmoi.pathListSeparator }} [
          {
            "command"{{ .chezmoi.pathListSeparator }} "bash '{{ .chezmoi.destDir }}{{ .chezmoi.pathSeparator }}.codex{{ .chezmoi.pathSeparator }}herdr-agent-state.sh' session",
            "timeout"{{ .chezmoi.pathListSeparator }} 10,
            "type"{{ .chezmoi.pathListSeparator }} "command"
          }
        ]
      }
    ],
    "UserPromptSubmit"{{ .chezmoi.pathListSeparator }} [
      {
        "hooks"{{ .chezmoi.pathListSeparator }} [
          {
            "command"{{ .chezmoi.pathListSeparator }} "echo '{\"hookSpecificOutput\"{{ .chezmoi.pathListSeparator }}{\"hookEventName\"{{ .chezmoi.pathListSeparator }}\"UserPromptSubmit\",\"additionalContext\"{{ .chezmoi.pathListSeparator }}\"ツール実行より先に、この発話への返答 (回答、または受け止めと進め方) を本文で書くこと。\"{{ "}}" }}'",
            "type"{{ .chezmoi.pathListSeparator }} "command"
          }
        ]
      }
    ]
  }
}