notify = ["{{ .chezmoi.homeDir }}/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]

# Claude Code's "sonnet" has no one-to-one Codex model equivalent.
# GPT-5.6 Terra is the closest balanced intelligence/cost choice.
model = "gpt-5.6-terra"
model_reasoning_effort = "high"
service_tier = "default"

# Keep commands sandboxed and limit outbound access to GitHub.
sandbox_mode = "workspace-write"
approval_policy = "on-request"

[marketplaces.openai-bundled]
last_updated = "2026-08-21T01:49:44Z"
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

